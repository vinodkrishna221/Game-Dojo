  "domainOwnership": {
    "gameplay": {
      "paths": [
        "Assets/Scripts/Core/**",
        "Assets/Scripts/Gameplay/**"
      ],
      "primaryOwners": ["gameplay-dev"],
      "backupOwners": ["lead"]
    },
    "monetization": {
      "paths": [
        "Assets/Plugins/WebGL/**",
        "Assets/Scripts/CrazyGames/**",
        "Assets/Scripts/Monetization/**",
        "Assets/WebGLTemplates/**"
      ],
      "primaryOwners": ["monetization-dev"],
      "backupOwners": ["lead"]
    },
    "art": {
      "paths": [
        "tools/blender/**",
        "Assets/Models/**",
        "Assets/Materials/**",
        "Assets/Prefabs/**"
      ],
      "primaryOwners": ["art-dev"],
      "backupOwners": ["lead"]
    },
    "contracts_and_governance": {
      "paths": [
        ".ai-team/**",
        ".github/**",
        "docs/**",
        "GEMINI.md",
        "AGENTS.md",
        "DESIGN_SYSTEM.md",
        "README.md",
        "package.json"
      ],
      "primaryOwners": ["lead"],
      "backupOwners": []
    }
  },
  "communication": {
    "chatChannel": "#brotel-dev",
    "prReviewPolicy": "All feature pull requests require review and merge approval by the project lead (@lead). Teammates must adhere strictly to task touchesFiles boundaries."
  }
